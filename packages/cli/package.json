{
  "name": "@praagney/elix",
  "version": "0.2.9",
  "private": false,
  "description": "Connect an explicitly exposed local coding workspace to the Elix MCP relay.",
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "bin": {
    "elix": "dist/main.js"
  },
  "main": "dist/main.js",
  "files": [
    "dist/main.js",
    "dist/app.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node scripts/build-package.mjs",
    "hud:preview": "node --import tsx scripts/hud-preview.ts",
    "test": "node --import tsx --test src/*.test.ts src/worker/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@napi-rs/keyring": "1.3.0",
    "ink": "7.1.1",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@elix/protocol": "*",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/semver": "7.7.1",
    "@xterm/headless": "6.0.0",
    "dejavu-fonts-ttf": "2.37.3",
    "esbuild": "0.28.1",
    "semver": "7.7.2",
    "tsx": "4.20.6",
    "typescript": "7.0.2"
  },
  "keywords": [
    "chatgpt",
    "chatgpt-plugin",
    "mcp",
    "model-context-protocol",
    "codex",
    "local-development",
    "developer-tools",
    "cli"
  ],
  "license": "MIT",
  "homepage": "https://elix-eight.vercel.app/docs/quickstart",
  "bugs": "https://elix-eight.vercel.app/support",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
