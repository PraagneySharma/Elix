NODE_ENV=development
ELIX_BIND_HOST=127.0.0.1
PORT=39100
DATABASE_URL=postgres://elix:elix@localhost:55432/elix
ELIX_DATABASE_SSL_MODE=verify-full
# ELIX_DATABASE_CA_PEM="-----BEGIN CERTIFICATE-----..."
ELIX_PUBLIC_ORIGIN=http://localhost:39100
ELIX_AUTH0_ISSUER=https://YOUR_TENANT.auth0.com/
ELIX_AUTH0_AUDIENCE=https://mcp.elix.invalid/
# Provider-wide subjects for regular users. Use an exact subject for a
# dedicated reviewer rather than broadening this list to auth0|.
ELIX_AUTH0_ALLOWED_SUBJECT_PREFIXES=google-oauth2|
# ELIX_AUTH0_ALLOWED_SUBJECTS=auth0|REVIEWER_USER_ID
ELIX_MCP_REQUIRED_SCOPE=elix:access
ELIX_DEVICE_ENROLL_SCOPE=elix:device
ELIX_RATE_LIMIT_WINDOW_MS=60000
ELIX_ENROLL_RATE_LIMIT=10
ELIX_DEVICE_AUTH_RATE_LIMIT=120
ELIX_MCP_RATE_LIMIT=300
ELIX_IP_RATE_LIMIT=1200
ELIX_MAX_WORKERS_PER_ACCOUNT=16
ELIX_MAX_WORKERS=2000
ELIX_WORKER_POLL_MS=15000
ELIX_RELAY_REQUEST_TIMEOUT_MS=18000
# Optional metadata-only request timing logs: operation, status, and duration.
ELIX_TIMING_LOGS=0
# Set only while OpenAI domain verification requires the generated token.
# ELIX_OPENAI_APPS_CHALLENGE=PASTE_EXACT_PORTAL_TOKEN_HERE
# Optional control panel at /panel for pairing-code redemption and device
# recovery. Requires an Auth0 Regular Web Application; the panel is enabled
# only when all three values are set. The session secret must be at least 32
# characters and stays in the relay environment, never in the database.
# ELIX_PANEL_CLIENT_ID=WEB_APPLICATION_CLIENT_ID
# ELIX_PANEL_CLIENT_SECRET=WEB_APPLICATION_CLIENT_SECRET
# ELIX_PANEL_SESSION_SECRET=LONG_RANDOM_VALUE
